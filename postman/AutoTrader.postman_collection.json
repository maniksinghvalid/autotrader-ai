              {
                "key": "X-Webhook-Token",
                "value": "{{webhook_secret}}"
              },
              {
                "key": "X-Webhook-Signature",
                "value": "sha256=deadbeef"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routine_id\": \"routine-20260615-1134-20219d\",\n  \"timestamp\": \"2026-06-15T11:34:00\",\n  \"signal_changes\": [\n    {\n      \"ticker\": \"US.DIVO\",\n      \"direction\": \"UP\",\n      \"transition\": [\n        \"HOLD\",\n        \"BUY\"\n      ],\n      \"points_delta\": 7,\n      \"driver\": \"ticker sweep (score 71)\"\n    },\n    {\n      \"ticker\": \"CA.VDY\",\n      \"direction\": \"UP\",\n      \"transition\": [\n        \"HOLD\",\n        \"BUY\"\n      ],\n      \"points_delta\": 8,\n      \"driver\": \"ticker sweep (score 77)\"\n    },\n    {\n      \"ticker\": \"US.YNVDA\",\n      \"direction\": \"DOWN\",\n      \"transition\": [\n        \"CAUTION\",\n        \"AVOID\"\n      ],\n      \"points_delta\": -10,\n      \"driver\": \"ticker sweep (score 22)\"\n    }\n  ],\n  \"hard_stops\": {},\n  \"catalysts\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{webhook_base_url}}/webhook/sweep",
              "host": [
                "{{webhook_base_url}}"
              ],
              "path": [
                "webhook",
                "sweep"
              ]
            },
            "description": "No signing script \u2014 deliberately wrong signature. Constant-time HMAC check rejects."
          }
        },
