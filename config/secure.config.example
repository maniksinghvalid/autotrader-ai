# Copy to config/secure.config (GITIGNORED) and fill in. NEVER commit secrets.
# Source it alongside risk.config:  set -a && source config/secure.config && set +a
#
# Shared secret for the webhook ingress (Phase 2c-W). Used BOTH as the
# X-Webhook-Token header value AND as the HMAC-SHA256 key over the raw request
# body. Generate a long random string:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AUTOTRADER_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Webhook bind — LOCALHOST ONLY. Expose publicly with `ngrok http 8799`.
AUTOTRADER_WEBHOOK_HOST=127.0.0.1
AUTOTRADER_WEBHOOK_PORT=8799
AUTOTRADER_WEBHOOK_MAX_BODY=65536

# Slack incoming-webhook URL for the end-of-day session report (posts to
# #portfolio_updates). Leave unset to disable EOD reporting entirely (the
# runner behaves exactly as without it). Create one at:
#   https://api.slack.com/messaging/webhooks
AUTOTRADER_SLACK_WEBHOOK_URL=

# Massive API (formerly Polygon.io) key for historical OHLCV data used by the
# backtesting engine (python -m autotrader.backtest — see docs/BACKTESTING.md).
# Not needed for live/paper trading. A fully cached backtest run needs no key
# at all — this is only read on a cache miss.
MASSIVE_API_KEY=YOUR_API_KEY_HERE
