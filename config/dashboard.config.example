  "opend_ready_timeout": 30,
  "_opend_note": "Seconds the startup health check will poll OpenD (exponential backoff) before reporting it is not ready.",

  "preferred_market": "US",
  "_market_note": "Market used to query an account when several are authorized (US / HK / CN / SG / HKCC)."
